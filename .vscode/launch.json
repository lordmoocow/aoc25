{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "aoc run",
            "type": "debugpy",
            "request": "launch",
            "module": "aoc.cli",
            "args": ["run", "${input:day}", "-p", "${input:part}", "-i", "${input:inputFile}"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ],
    "inputs": [
        {"id": "day", "type": "promptString", "description": "Day number", "default": "8"},
        {"id": "part", "type": "promptString", "description": "Part (1 or 2)", "default": "1"},
        {"id": "inputFile", "type": "promptString", "description": "Input file", "default": "test.txt"}
    ]
}
